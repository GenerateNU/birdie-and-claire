# Copy to /opt/shared/.env on the droplet (chmod 600).

# Let's Encrypt expiry notifications.
ACME_EMAIL=

# Superuser password for the preview-only Postgres. Generate it with
#   openssl rand -hex 32
# Hex, not base64: preview-up.sh puts it in a postgres:// URL unescaped, and
# base64's "/" and "+" would corrupt it.
PREVIEW_DB_PASSWORD=
