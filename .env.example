# Docker Compose reads a .env file in this directory, so copying this file to
# .env and filling it in is enough to run the stack without any secret
# injector. Today mise tasks inject these through a secrets manager instead.

DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
API_PORT=
PUBLIC_API_URL=

SUPABASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Object storage (profile pictures). The backend speaks the S3 API, so any
# S3-compatible store works: Floci locally, Supabase Storage in production, or
# real AWS.
#
# The browser uploads straight to the bucket with a presigned PUT URL from the
# backend, then reads the object back from S3_PUBLIC_URL. The backend itself
# only checks, deletes, and presigns objects.

# Where the backend sends S3 API calls. Locally this is Floci; compose rewrites
# any non-empty value to http://floci:4566, its address inside Docker. In
# production it is https://<project-ref>.storage.supabase.co/storage/v1/s3.
# Leave it and S3_PUBLIC_ENDPOINT empty for real AWS, which the SDK finds from
# S3_REGION.
S3_ENDPOINT=
# Where the browser sends presigned uploads. Presigned URLs are signed for this
# host, so it has to be one the browser can reach: http://localhost:4566 for
# Floci, the same value as S3_ENDPOINT for Supabase. Set it together with
# S3_ENDPOINT, or leave both empty.
S3_PUBLIC_ENDPOINT=
# Base URL objects are read from. The API returns <S3_PUBLIC_URL>/<key> as a
# profile picture's URL, so no trailing slash. This is a different path from
# the S3 API, which needs signed requests:
#   Floci:    http://localhost:4566/<bucket>
#   Supabase: https://<project-ref>.supabase.co/storage/v1/object/public/<bucket>
#   AWS:      https://<bucket>.s3.<region>.amazonaws.com
S3_PUBLIC_URL=
# Region used to sign requests. Floci takes any value, Supabase wants the
# project's region (e.g. us-east-1), and AWS wants the bucket's region.
S3_REGION=
# Bucket name. mise run floci:bucket creates it locally; in Supabase, create it
# in the dashboard and make it public so S3_PUBLIC_URL works without signing.
S3_BUCKET=
# Largest profile picture the backend accepts, in bytes. It checks the size of
# the uploaded object after the browser's PUT, not before. Defaults to 5242880
# (5 MiB) when empty.
S3_MAX_UPLOAD_BYTES=
# S3 credentials. Floci accepts test/test. For Supabase they come from Project
# Settings, Storage, S3 Access Keys, not from the anon or service role key.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

#Modal
EMBEDDER_URL=
MODAL_PROXY_KEY=
MODAL_PROXY_SECRET=

#OpenRouter
AI_URL=
AI_API_KEY=
AI_MODEL=
AI_DEV_USER_IDS=
