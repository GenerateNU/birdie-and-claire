# Docker Compose reads a .env file in this directory, so copying this file to
# .env and filling it in is enough to run the stack without any secret
# injector. Today mise tasks inject these through a secrets manager instead.

DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
API_PORT=

SUPABASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

#AWS
S3_ENDPOINT=http://localhost:4566
S3_PUBLIC_ENDPOINT=http://localhost:4566
S3_REGION=us-east-1
S3_BUCKET=birdie-and-claire-profile-pictures
S3_MAX_UPLOAD_BYTES=5242880
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test