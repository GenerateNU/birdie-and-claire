# The committed list of required variable names. No secret values belong here.
#
# Docker Compose reads a .env file in this directory, so copying this file to
# .env and filling it in is enough to run the stack without any secret
# injector. Today mise tasks inject these through Keyflare instead.

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=
API_PORT=
